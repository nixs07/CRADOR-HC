# =====================================================================
# CRADOR-HC - Configuracion (copiar este archivo como .env y ajustar)
# El archivo .env NUNCA se sube a GitHub (esta en .gitignore).
# =====================================================================

# --- Aplicacion ---------------------------------------------------------
# Puerto del equipo donde se abre la app: http://IP-DEL-EQUIPO:8080
APP_PUERTO=8080
# Login de SIHOS que tiene rol de administrador en la contingencia
ADMIN_LOGIN=NIXON07
# Minutos de inactividad antes de cerrar la sesion
SESION_MINUTOS=480
# Zona horaria (Colombia)
TZ=America/Bogota

# --- Base de datos LOCAL (contenedor "db", MySQL 5.6) --------------------
# Dentro de Docker el host es "db" y el puerto 3306. Solo cambiar si la BD
# local corre fuera de Docker.
DB_HOST=db
DB_PUERTO=3306
DB_NOMBRE=crador_hc
DB_USUARIO=crador
DB_CLAVE=cambiar_esta_clave
# Clave del usuario root de MySQL local (solo para administracion)
DB_CLAVE_ROOT=cambiar_esta_clave_root
# Puerto del equipo para conectarse a la BD local con HeidiSQL/Workbench.
# Solo escucha en el propio equipo (127.0.0.1).
DB_PUERTO_EQUIPO=3307

# --- Base de datos ORIGEN (SIHOS) para copiar catalogos -----------------
# Usuario de SOLO LECTURA en SIHOS. Se usa para copiar catalogos y para
# saber si SIHOS esta arriba o caido.
SIHOS_HOST=192.168.0.250
SIHOS_PUERTO=3306
SIHOS_NOMBRE=sihos
SIHOS_USUARIO=usuario_lectura
SIHOS_CLAVE=
# Segundos maximos para esperar respuesta de SIHOS
SIHOS_TIMEOUT=3
